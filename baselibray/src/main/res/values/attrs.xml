<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 注意：名字必须是 ShineViewWrapper，与类名一致 -->
    <declare-styleable name="ShineViewWrapper">
        <!-- 基础控制 -->
        <attr name="auto_start" format="boolean" />
        <attr name="shine_enabled" format="boolean" />

        <!-- 角度相关 -->
        <attr name="shine_angle" format="float" />
        <attr name="shine_direction" format="enum">
            <enum name="horizontal" value="0" />
            <enum name="vertical" value="90" />
            <enum name="diagonal" value="45" />
            <enum name="reverse_diagonal" value="135" />
        </attr>

        <!-- 动画相关 -->
        <attr name="shine_duration" format="integer" />
        <attr name="shine_repeat_count" format="integer" />
        <attr name="shine_repeat_mode" format="enum">
            <enum name="restart" value="1" />
            <enum name="reverse" value="2" />
        </attr>

        <!-- 外观相关 -->
        <attr name="shine_width" format="dimension" />
        <attr name="shine_color" format="color" />
        <attr name="shine_alpha" format="integer" />
        <attr name="shine_secondary_color" format="color" />

        <!-- 插值器类型 -->
        <attr name="shine_interpolator" format="enum">
            <enum name="linear" value="0" />
            <enum name="accelerate" value="1" />
            <enum name="decelerate" value="2" />
            <enum name="accelerate_decelerate" value="3" />
            <enum name="bounce" value="4" />
            <enum name="overshoot" value="5" />
        </attr>
    </declare-styleable>
    <declare-styleable name="ColorfulTextView">
        <attr name="outlineColor" format="color" />
        <attr name="outlineWidth" format="dimension" />
        <attr name="gradientColors" format="reference" />
        <attr name="shadowColor" format="color" />
        <attr name="shadowDx" format="dimension" />
        <attr name="shadowDy" format="dimension" />
        <attr name="shadowRadius" format="dimension" />
        <attr name="fontFamily" format="string" />
        <attr name="textStyle">
            <flag name="normal" value="0" />
            <flag name="bold" value="1" />
            <flag name="italic" value="2" />
        </attr>
        <attr name="gradientOrientation" format="integer">
            <enum name="horizontal" value="0" />
            <enum name="vertical" value="1" />
        </attr>
        
        <!-- 流光特效属性 -->
        <attr name="shineEnabled" format="boolean" />
        <attr name="shineSpeed" format="integer" />
        <attr name="shineColors" format="reference" />
    </declare-styleable>
    <declare-styleable name="ShimmerTextView">
        <!-- 描边相关属性 -->
        <attr name="shimmeroutlineColor" format="color" />
        <attr name="shimmeroutlineWidth" format="dimension" />

        <!-- 渐变相关属性 -->
        <attr name="shimmergradientColors" format="reference" />
        <attr name="shimmergradientOrientation" format="enum">
            <enum name="horizontal" value="0" />
            <enum name="vertical" value="1" />
        </attr>

        <!-- 阴影相关属性 -->
        <attr name="shimmershadowColor" format="color" />
        <attr name="shimmershadowDx" format="dimension" />
        <attr name="shimmershadowDy" format="dimension" />
        <attr name="shimmershadowRadius" format="dimension" />

        <!-- 流光相关属性 -->
        <attr name="shimmerEnabled" format="boolean" />
        <attr name="shimmerColor" format="color" />
        <attr name="shimmerWidth" format="float" />
        <attr name="shimmerSpeed" format="integer" />
        <attr name="shimmerAngle" format="float" />

        <!-- 字体相关属性 -->
        <attr name="shimmerfontFamily" format="reference" />
        <attr name="shimmertextStyle" format="enum">
            <enum name="normal" value="0" />
            <enum name="bold" value="1" />
            <enum name="italic" value="2" />
            <enum name="bold_italic" value="3" />
        </attr>
    </declare-styleable>
    <declare-styleable name="CountdownTextView">
        <attr name="progressColor" format="color" />
        <attr name="progressWidth" format="dimension" />
        <attr name="cornerRadius" format="dimension" />
    </declare-styleable>
    <declare-styleable name="ScoreBoardView">
        <!-- 数字之间的间距 -->
        <attr name="digitSpacing" format="dimension" />

        <!-- 数字宽度（设置为0表示使用图片原始宽高比） -->
        <attr name="digitWidth" format="dimension" />

        <!-- 数字高度（设置为0表示使用图片原始宽高比） -->
        <attr name="digitHeight" format="dimension" />

        <!-- 是否保持图片原始宽高比 -->
        <attr name="keepOriginalAspectRatio" format="boolean" />

        <!-- 卡片背景颜色 -->
        <attr name="cardColor" format="color" />

        <!-- 卡片内边距 -->
        <attr name="cardPadding" format="dimension" />
        <!-- 最少显示位数 -->
        <attr name="minDigits" format="integer" />
    </declare-styleable>
</resources>