<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_kids_home"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 顶部装饰云朵 -->
        <TextView
            android:id="@+id/tvCloud1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="☁️"
            android:textSize="44sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvCloud2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:layout_marginEnd="60dp"
            android:text="☁️"
            android:textSize="30sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:shadowColor="#33FF9800"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="3"
            android:text="🌞 儿童乐园"
            android:textColor="#FFFFFF"
            android:textSize="38sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="数字 · 加减法 · 汉字 快乐学"
            android:textColor="#CCFFFFFF"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <!-- 数字模块入口卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="32dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#55FFFFFF"
            app:cardCornerRadius="28dp"
            app:cardElevation="6dp"
            app:strokeColor="#AAFFFFFF"
            app:strokeWidth="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tvNumberEmoji"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_home_icon"
                    android:backgroundTint="@color/kids_sky_blue_deep"
                    android:gravity="center"
                    android:text="🔢"
                    android:textSize="34sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:id="@+id/tvNumberTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="数字乐园"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tvNumberEmoji"
                    app:layout_constraintTop_toTopOf="@id/tvNumberEmoji" />

                <TextView
                    android:id="@+id/tvNumberDesc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="4dp"
                    android:text="认识数字 0-30 · 会听会说"
                    android:textColor="#EEFFFFFF"
                    android:textSize="13sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tvNumberEmoji"
                    app:layout_constraintTop_toBottomOf="@id/tvNumberTitle" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressNumber"
                    android:layout_width="0dp"
                    android:layout_height="10dp"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="12dp"
                    app:indicatorColor="#FFFFFF"
                    app:trackColor="#55FFFFFF"
                    app:trackCornerRadius="5dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tvNumberEmoji"
                    app:layout_constraintTop_toBottomOf="@id/tvNumberDesc" />

                <TextView
                    android:id="@+id/tvNumberProgress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="4dp"
                    android:text="认识数字: 0 个"
                    android:textColor="#FFFFF59D"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tvNumberEmoji"
                    app:layout_constraintTop_toBottomOf="@id/progressNumber" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 加减法入口卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardArithmetic"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="20dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#55FFFFFF"
            app:cardCornerRadius="28dp"
            app:cardElevation="6dp"
            app:strokeColor="#AAFFFFFF"
            app:strokeWidth="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardNumber">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tvArithmeticEmoji"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_home_icon"
                    android:backgroundTint="@color/kids_grass"
                    android:gravity="center"
                    android:text="🧮"
                    android:textSize="34sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:id="@+id/tvArithmeticTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="加减法练习"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tvArithmeticEmoji"
                    app:layout_constraintTop_toTopOf="@id/tvArithmeticEmoji" />

                <TextView
                    android:id="@+id/tvArithmeticDesc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="4dp"
                    android:text="简单 ≤10 · 进阶 ≤20 · 挑战 ≤100"
                    android:textColor="#EEFFFFFF"
                    android:textSize="13sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tvArithmeticEmoji"
                    app:layout_constraintTop_toBottomOf="@id/tvArithmeticTitle" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressArithmetic"
                    android:layout_width="0dp"
                    android:layout_height="10dp"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="12dp"
                    app:indicatorColor="#FFFFFF"
                    app:trackColor="#55FFFFFF"
                    app:trackCornerRadius="5dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tvArithmeticEmoji"
                    app:layout_constraintTop_toBottomOf="@id/tvArithmeticDesc" />

                <TextView
                    android:id="@+id/tvArithmeticProgress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="4dp"
                    android:text="最佳连胜: 0 · 已玩 0 局"
                    android:textColor="#FFFFF59D"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tvArithmeticEmoji"
                    app:layout_constraintTop_toBottomOf="@id/progressArithmetic" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 汉字模块入口卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardChinese"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="20dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#55FFFFFF"
            app:cardCornerRadius="28dp"
            app:cardElevation="6dp"
            app:strokeColor="#AAFFFFFF"
            app:strokeWidth="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardArithmetic">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tvChineseEmoji"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_home_icon"
                    android:backgroundTint="@color/kids_coral"
                    android:gravity="center"
                    android:text="📖"
                    android:textSize="34sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:id="@+id/tvChineseTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="汉字乐园"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tvChineseEmoji"
                    app:layout_constraintTop_toTopOf="@id/tvChineseEmoji" />

                <TextView
                    android:id="@+id/tvChineseDesc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="4dp"
                    android:text="笔画演示 · 汉字识字 · 仿写描红"
                    android:textColor="#EEFFFFFF"
                    android:textSize="13sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tvChineseEmoji"
                    app:layout_constraintTop_toBottomOf="@id/tvChineseTitle" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressChinese"
                    android:layout_width="0dp"
                    android:layout_height="10dp"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="12dp"
                    app:indicatorColor="#FFFFFF"
                    app:trackColor="#55FFFFFF"
                    app:trackCornerRadius="5dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tvChineseEmoji"
                    app:layout_constraintTop_toBottomOf="@id/tvChineseDesc" />

                <TextView
                    android:id="@+id/tvChineseProgress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="4dp"
                    android:text="已学汉字: 0 / 32 个"
                    android:textColor="#FFFFF59D"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tvChineseEmoji"
                    app:layout_constraintTop_toBottomOf="@id/progressChinese" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- H5 小游戏入口卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardH5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="20dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#55FFFFFF"
            app:cardCornerRadius="28dp"
            app:cardElevation="6dp"
            app:strokeColor="#AAFFFFFF"
            app:strokeWidth="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardChinese">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tvH5Emoji"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_home_icon"
                    android:backgroundTint="@color/kids_purple"
                    android:gravity="center"
                    android:text="🎮"
                    android:textSize="34sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:id="@+id/tvH5Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="H5 小游戏"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tvH5Emoji"
                    app:layout_constraintTop_toTopOf="@id/tvH5Emoji" />

                <TextView
                    android:id="@+id/tvH5Desc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="4dp"
                    android:text="数字翻牌 · 汉字连连看 快乐玩"
                    android:textColor="#EEFFFFFF"
                    android:textSize="13sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tvH5Emoji"
                    app:layout_constraintTop_toBottomOf="@id/tvH5Title" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="点击进入 ›"
                    android:textColor="#FFFFF59D"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="@id/tvH5Desc"
                    app:layout_constraintTop_toBottomOf="@id/tvH5Desc" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 演示中心入口（原 MainActivity） -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDemo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="20dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#33445566"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardH5">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎨"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="演示中心（特效组件展示）"
                    android:textColor="#CCFFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="进入 ›"
                    android:textColor="#88FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 底部装饰 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp"
            android:text="🌈🎈✨🎉"
            android:textSize="26sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardDemo" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
