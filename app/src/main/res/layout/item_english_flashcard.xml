<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="4dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="#FFFFFFFF"
    app:cardCornerRadius="28dp"
    app:cardElevation="10dp"
    app:strokeColor="@color/kids_sky_blue_deep"
    app:strokeWidth="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvFlashEmoji"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:background="@drawable/bg_icon_round"
            android:gravity="center"
            android:text="🍎"
            android:textSize="40sp" />

        <TextView
            android:id="@+id/tvFlashWord"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="apple"
            android:textColor="@color/kids_text_deep"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFlashPhonetic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="/ˈæpl/"
            android:textColor="@color/kids_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvFlashChinese"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="苹果"
            android:textColor="@color/kids_coral"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/viewFlashDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="#33FF9800" />

        <ScrollView
            android:id="@+id/flashExampleScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:scrollbars="none"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/flashExampleList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <Button
            android:id="@+id/btnSpeakFlash"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="@color/kids_orange"
            android:text="🔊 听单词发音"
            android:textColor="@color/white"
            android:textSize="15sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
