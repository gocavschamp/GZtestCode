<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:paddingTop="44dp"
    android:layout_height="match_parent">
    <com.ywm.baselibray.scoreview.ScoreBoardView
        android:id="@+id/scoreview"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="match_parent"
        app:minDigits="8"
        android:layout_height="50dp"/>
    <com.ywm.baselibray.scoreview.ScoreBoardView
        android:id="@+id/scoreBoard2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scoreview"
        android:layout_width="match_parent"
        android:layout_marginTop="30dp"
        android:layout_height="100dp"
        android:layout_marginBottom="16dp"
        app:digitWidth="30dp"
        app:digitHeight="50dp"
        app:digitSpacing="10dp"
        app:minDigits="7"
        app:cardColor="#2196F3" />
    <Button
        android:id="@+id/picker"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="dialog activity"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <Button
        android:id="@+id/picker1"
        android:visibility="gone"

        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="dialog view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/picker" />
    <Button
        android:id="@+id/picker2"
        android:visibility="gone"

        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="扩展函数"
        app:layout_constraintTop_toBottomOf="@id/picker1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>