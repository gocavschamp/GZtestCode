<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_kids_arithmetic">

    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="➕ 数字加减法"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 难度选择 -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupLevel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:chipSpacingHorizontal="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvHeader">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipLevel1"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="简单 (≤10)"
            android:textColor="@color/white"
            app:chipBackgroundColor="@color/kids_grass"
            app:chipStrokeColor="@color/white"
            app:chipStrokeWidth="2dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipLevel2"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="进阶 (≤20)"
            android:textColor="@color/white"
            app:chipBackgroundColor="@color/kids_orange"
            app:chipStrokeColor="@color/white"
            app:chipStrokeWidth="2dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipLevel3"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="挑战 (≤100)"
            android:textColor="@color/white"
            app:chipBackgroundColor="@color/kids_purple"
            app:chipStrokeColor="@color/white"
            app:chipStrokeWidth="2dp" />
    </com.google.android.material.chip.ChipGroup>

    <!-- 得分 & 连胜 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chipGroupLevel">

        <TextView
            android:id="@+id/tvScore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="得分: 0"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStreak"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="连胜: 0"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvBest"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="最佳: 0"
            android:textColor="#FFF59D"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 题目卡片 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardQuestion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="32dp"
        app:cardElevation="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvScore">

        <TextView
            android:id="@+id/tvQuestion"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:gravity="center"
            android:text="3 + 4 = ?"
            android:textColor="@color/kids_text_deep"
            android:textSize="44sp"
            android:textStyle="bold" />
    </com.google.android.material.card.MaterialCardView>

    <!-- 结果反馈 -->
    <TextView
        android:id="@+id/tvFeedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text=""
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardQuestion" />

    <!-- 答案选项 -->
    <LinearLayout
        android:id="@+id/answerRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvFeedback">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAns1"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:textSize="24sp"
            android:textColor="@color/white"
            android:text="1"
            app:backgroundTint="@color/kids_sky_blue_deep"
            app:cornerRadius="20dp"
            app:elevation="3dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAns2"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:textSize="24sp"
            android:textColor="@color/white"
            android:text="2"
            app:backgroundTint="@color/kids_orange"
            app:cornerRadius="20dp"
            app:elevation="3dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAns3"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:textSize="24sp"
            android:textColor="@color/white"
            android:text="3"
            app:backgroundTint="@color/kids_grass"
            app:cornerRadius="20dp"
            app:elevation="3dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnNext"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/kids_pink"
        android:text="下一题 ➜"
        android:textColor="@color/kids_text_deep"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/answerRow" />

</androidx.constraintlayout.widget.ConstraintLayout>
